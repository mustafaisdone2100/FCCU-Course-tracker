{
  "version": 2,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh?term=2027SP",
      "schedule": "0 * * * *"
    }
  ]
}
